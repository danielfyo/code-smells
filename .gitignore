# =============================================================================
# .gitignore for the code smells monorepo: Python · C#/.NET · React+TS (Node) · Go
# Based on the official github/gitignore templates (Python, VisualStudio, Node,
# Go), trimmed down and anchored to each subproject so no source code is ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.sublime-workspace
.history/
.fleet/

# Visual Studio / Rider
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
_ReSharper*/
*.DotSettings.user
.ionide/

# -----------------------------------------------------------------------------
# Secrets and local environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
tmp/

# =============================================================================
# C# / .NET  (csharp/)
# =============================================================================
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/
BenchmarkDotNet.Artifacts/
ScaffoldingReadMe.txt
mono_crash.*
*.pdb
*.cache
*.binlog

# =============================================================================
# Python  (python/)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
python/build/
python/dist/
python/sdist/
pip-wheel-metadata/
*.whl
pip-log.txt
# Virtual environments
.venv/
venv/
python/env/
ENV/
# Test, typing and lint tools
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
# Jupyter
.ipynb_checkpoints/

# =============================================================================
# React + TypeScript / Node  (react-ts/)
# =============================================================================
node_modules/
react-ts/dist/
react-ts/build/
react-ts/coverage/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Go  (go/)
# =============================================================================
# Binaries
*.exe
*.exe~
*.dll
*.dylib
go/bin/
# Test binaries and coverage profiles
*.test
*.out
*.prof
coverage.html
# Local workspaces
go.work
go.work.sum
vendor/
